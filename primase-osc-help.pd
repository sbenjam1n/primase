#N canvas 50 50 1200 900 12;
#X text 30 20 primase-osc - OSC Control Interface for primase;
#X text 30 50 Control all primase parameters via Open Sound Control (OSC);
#X text 30 75 Requires: mrpeach library ([udpreceive] and [unpackOSC]);
#X text 30 100 ------------------------------------------------------------;
#X text 30 125 USAGE:;
#X text 50 150 1. Create [primase-osc 9001];
#X text 50 170 2. Connect outlet to [primase] inlet;
#X text 50 190 3. Send OSC messages to port 9001;
#X text 30 220 ------------------------------------------------------------;
#X text 30 245 OSC ADDRESS SCHEME: /primase/<category>/<parameter>;
#X text 30 280 /transport (7 routes):;
#X text 50 300 /primase/transport/play -> play (bang);
#X text 50 318 /primase/transport/stop -> stop (bang);
#X text 50 336 /primase/transport/record -> record (bang);
#X text 50 354 /primase/transport/overdub -> overdub (bang);
#X text 50 372 /primase/transport/loop <float> -> loop;
#X text 50 390 /primase/transport/sync <float> -> sync;
#X text 50 408 /primase/transport/transparent <float> -> transparent;
#X text 30 436 /tempo (5 routes):;
#X text 50 456 /primase/tempo/bpm <float> -> tempo;
#X text 50 474 /primase/tempo/beats <float> -> beats;
#X text 50 492 /primase/tempo/clockfollow <float> -> clockfollow;
#X text 50 510 /primase/tempo/clockdiv <float> -> clockdiv;
#X text 50 528 /primase/tempo/metric <float> <float> -> metric;
#X text 30 556 /pattern (6 routes):;
#X text 50 576 /primase/pattern/clear -> clear (bang);
#X text 50 594 /primase/pattern/set <float...> -> set;
#X text 50 612 /primase/pattern/set_source <float...> -> set_source;
#X text 50 630 /primase/pattern/tap_at <float> [float] -> tap_at;
#X text 50 648 /primase/pattern/quantize <float> -> quantize;
#X text 50 666 /primase/pattern/grid <float> -> grid;
#X text 30 694 /variation (5 routes):;
#X text 50 714 /primase/variation/jitter <float> -> jitter;
#X text 50 732 /primase/variation/skip <float> -> skip;
#X text 50 750 /primase/variation/skipweight <float> <float> -> skipweight;
#X text 50 768 /primase/variation/swing <float> -> swing;
#X text 50 786 /primase/variation/phase <float> -> phase;
#X text 30 814 /chain (6 routes):;
#X text 50 834 /primase/chain/add <symbol> <floats...> -> chain_add;
#X text 50 852 /primase/chain/remove <float> -> chain_remove;
#X text 50 870 /primase/chain/replace <float> <symbol> <floats...> -> chain_replace;
#X text 50 888 /primase/chain/bypass <float> <float> -> chain_bypass;
#X text 50 906 /primase/chain/clear -> chain_clear (bang);
#X text 50 924 /primase/chain/dump -> chain_dump (bang);
#X text 30 952 /scene (2 routes):;
#X text 50 972 /primase/scene/store <float> -> store;
#X text 50 990 /primase/scene/recall <float> -> recall;
#X text 30 1018 /file (2 routes):;
#X text 50 1038 /primase/file/write <symbol> -> write;
#X text 50 1056 /primase/file/read <symbol> -> read;
#X text 30 1084 /query (6 routes):;
#X text 50 1104 /primase/query/getpattern -> getpattern (bang);
#X text 50 1122 /primase/query/getvelocity -> getvelocity (bang);
#X text 50 1140 /primase/query/getsource -> getsource (bang);
#X text 50 1158 /primase/query/getparams -> getparams (bang);
#X text 50 1176 /primase/query/getchain -> getchain (bang);
#X text 50 1194 /primase/query/dump -> dump (bang);
#X text 30 1222 ------------------------------------------------------------;
#X text 30 1247 EXAMPLES (send with oscsend):;
#X text 50 1272 oscsend localhost 9001 /primase/transport/play;
#X text 50 1290 oscsend localhost 9001 /primase/transport/loop f 1;
#X text 50 1308 oscsend localhost 9001 /primase/tempo/bpm f 140;
#X text 50 1326 oscsend localhost 9001 /primase/tempo/metric ff 4 4;
#X text 50 1344 oscsend localhost 9001 /primase/pattern/set fff 0.0 0.25 0.5;
#X text 50 1362 oscsend localhost 9001 /primase/pattern/clear;
#X text 50 1380 oscsend localhost 9001 /primase/variation/jitter f 0.02;
#X text 50 1398 oscsend localhost 9001 /primase/variation/skipweight ff 2 0.3;
#X text 50 1416 oscsend localhost 9001 /primase/chain/add sf euclid 3 8;
#X text 50 1434 oscsend localhost 9001 /primase/chain/bypass ff 0 1;
#X text 50 1452 oscsend localhost 9001 /primase/scene/store f 0;
#X text 50 1470 oscsend localhost 9001 /primase/scene/recall f 0;
#X text 50 1488 oscsend localhost 9001 /primase/file/write s mypattern;
#X text 50 1506 oscsend localhost 9001 /primase/query/getparams;
#X text 50 1524 oscsend localhost 9001 /primase/query/dump;
